# ICEHOME 环境变量示例：复制为 .env 后按需修改
# 用法：node --env-file=.env server/src/index.js （或 npm run start:env）

# ---------- 服务 ----------
PORT=8787
HOST=0.0.0.0
# 调度器心跳（毫秒）
ICE_TICK_MS=15000

# ---------- 存储 ----------
# json（默认）| postgres | mysql；留空时按 STORAGE_URL 协议推断
# STORAGE_DRIVER=postgres
# STORAGE_URL=postgres://icehome:password@127.0.0.1:5432/icehome
# STORAGE_URL=mysql://icehome:password@127.0.0.1:3306/icehome
# JSON 模式的数据目录（默认 ./data，文件为 db.json）
# DATA_DIR=./data

# ---------- 缓存 ----------
# 留空使用进程内存；填写后自动连接 Redis，失败会降级内存并在界面提示
# REDIS_URL=redis://127.0.0.1:6379
CACHE_PREFIX=icehome:
# 页面缓存默认关闭，可在面板「设置 → 存储与缓存」开启

# ---------- 前后端分离 ----------
# false：后端只提供 /api 与 /v1，静态资源交给 nginx 或网关
SERVE_STATIC=true
# 允许跨域的来源，逗号分隔；示例：http://127.0.0.1:5173,https://panel.example.com
CORS_ORIGINS=

# ---------- 前端构建（Vite） ----------
# 与后端不同域时填写 API 根地址，例如 https://api.example.com
# VITE_API_BASE=

# ---------- 开发代理 ----------
# vite dev server 将 /api、/v1 代理到该地址
ICE_API_TARGET=http://127.0.0.1:8787

# ---------- 代理网关示例（examples/gateway） ----------
GATEWAY_PORT=8790
GATEWAY_UPSTREAM=http://127.0.0.1:8787
GATEWAY_DIST=./dist
# 网关层 IP 级缓存（秒）；0 关闭
GATEWAY_CACHE_TTL=5
