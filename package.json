{
  "name": "icehome",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "ICEHOME",
  "description": "ICEHOME - 黑白简约的家庭设备控制面板，参考 Home Assistant 设计",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "node --watch server/src/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/src/index.js",
    "start:env": "node --env-file=.env server/src/index.js",
    "start:api": "node scripts/start-api.mjs",
    "start:gateway": "node examples/gateway/server.mjs",
    "preview": "npm run build && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "e2e:server": "node tests/e2e/start-server.mjs",
    "desktop": "electron .",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:dir": "npm run build && electron-builder --dir",
    "test:desktop": "npm run build && playwright test -c playwright.desktop.config.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "redis": "^6.3.1"
  },
  "build": {
    "appId": "com.icehome.desktop",
    "productName": "ICEHOME",
    "asar": false,
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/assets/icon.png",
      "category": "Utility",
      "maintainer": "ICEHOME"
    }
  }
}
